<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>AirPlay Status</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="container">
    <header id="page-header" class="header" <%= live && playback.title ? 'hidden' : '' %>>
      <h1>📡 AirPlay Status</h1>
      <p id="subtitle"><%= live ? 'Live from AirPlay' : 'Mock preview' %></p>
    </header>

    <% if (live) { %>
      <div id="playback-view">
        <div id="empty-state" class="card card--empty" <%= playback.title ? 'hidden' : '' %>>
          <div class="empty-icon">🔇</div>
          <h2 class="empty-title">Nothing playing</h2>
          <p class="empty-subtitle">
            Select <strong>AirPlay Status</strong> as an output alongside your speakers to see track info here.
          </p>
        </div>

        <div id="track-card" class="card" <%= playback.title ? '' : 'hidden' %>>
          <div class="album-art-frame">
            <img
              id="album-art"
              class="album-art"
              src="<%= playback.albumArt || '' %>"
              alt="Album art"
              <%= playback.albumArt ? '' : 'hidden' %>
            >
            <div id="album-art-ph" class="album-art album-art--placeholder" <%= playback.albumArt ? 'hidden' : '' %>>🎵</div>
          </div>

          <div class="track-info">
            <h2 class="track-title" id="track-title"><%= playback.title || '' %></h2>
            <p class="track-artist" id="track-artist"><%= playback.artist || '' %></p>
            <p class="track-album" id="track-album"><%= playback.album || '' %></p>
          </div>

          <div class="progress-section">
            <div class="progress-bar">
              <div
                id="progress-fill"
                class="progress-fill"
                style="width: <%= playback.durationMs ? Math.min(100, Math.round((playback.progressMs / playback.durationMs) * 100)) : 0 %>%"
              ></div>
            </div>
            <div class="progress-times">
              <span id="progress-current"><%= formatMs(playback.progressMs) %></span>
              <span id="progress-total"><%= formatMs(playback.durationMs) %></span>
            </div>
          </div>

          <div class="status-row">
            <span id="status-badge" class="status-badge <%= playback.isPlaying ? '' : 'status-badge--paused' %>">
              <%= playback.isPlaying ? '▶ Playing' : '⏸ Paused' %>
            </span>
            <span class="source-info">
              <img src="/images/airplay-icon-white.png" alt="" class="airplay-icon" aria-hidden="true">
              <span id="track-source"><%= playback.source || 'AirPlay' %></span>
            </span>
          </div>
        </div>
      </div>

      <% if (showDebugCapture) { %>
      <div id="debug-bar" class="debug-bar">
        <p class="debug-bar__hint">Tap before each iPhone action — logged as <code>&gt;&gt;&gt; TEST MARK</code><% if (!metadataDebug) { %> (add <code>?debug=1</code> or use <code>./bin/run-debug.sh</code> for verbose pipe logs)<% } %></p>
        <div class="debug-bar__buttons">
          <button type="button" class="debug-btn" data-mark="1 connect + start playing">1 Play</button>
          <button type="button" class="debug-btn" data-mark="2 pause">2 Pause</button>
          <button type="button" class="debug-btn" data-mark="3 resume">3 Resume</button>
          <button type="button" class="debug-btn" data-mark="4 next track">4 Next</button>
          <button type="button" class="debug-btn" data-mark="5 pause again">5 Pause</button>
          <button type="button" class="debug-btn" data-mark="6 disconnect AirPlay Status">6 Disconnect</button>
        </div>
      </div>
      <% } %>
      <script src="/js/live.js" type="module"></script>
    <% } else { %>
      <div id="playback-view">
        <% if (!playback.isPlaying && !playback.title) { %>
          <div class="card card--empty">
            <div class="empty-icon">🔇</div>
            <h2 class="empty-title">Nothing playing</h2>
            <p class="empty-subtitle">Mock preview — use live mode for AirPlay.</p>
          </div>
        <% } else { %>
          <div class="card">
            <% if (playback.albumArt) { %>
              <img class="album-art" src="<%= playback.albumArt %>" alt="Album art">
            <% } else { %>
              <div class="album-art album-art--placeholder">🎵</div>
            <% } %>
            <div class="track-info">
              <h2 class="track-title"><%= playback.title %></h2>
              <p class="track-artist"><%= playback.artist %></p>
              <p class="track-album"><%= playback.album %></p>
            </div>
            <div class="progress-section">
              <div class="progress-bar">
                <div class="progress-fill" style="width: <%= playback.durationMs ? Math.round((playback.progressMs / playback.durationMs) * 100) : 0 %>%"></div>
              </div>
              <div class="progress-times">
                <span><%= formatMs(playback.progressMs) %></span>
                <span><%= formatMs(playback.durationMs) %></span>
              </div>
            </div>
            <div class="status-row">
              <span class="status-badge">▶ Playing</span>
              <span class="source-info">
                <img src="/images/airplay-icon-white.png" alt="" class="airplay-icon" aria-hidden="true">
                <%= playback.source || 'AirPlay' %>
              </span>
            </div>
          </div>
        <% } %>
      </div>
      <div class="toggle-section">
        <% if (forceNothingPlaying) { %>
          <a href="/?mock=true" class="toggle-btn">▶ Show Now Playing</a>
        <% } else { %>
          <a href="/?mock=true&state=nothing" class="toggle-btn">🔇 Show Nothing Playing</a>
        <% } %>
      </div>
    <% } %>

    <p style="text-align: center;">
      <span class="phase-tag"><%= live ? 'Live · AirPlay' : 'Mock preview' %></span>
      <% if (live) { %>
        <a href="/?mock=true" class="phase-tag" style="margin-left:0.5rem;text-decoration:none;">Mock</a>
      <% } %>
    </p>
  </div>
</body>
</html>
