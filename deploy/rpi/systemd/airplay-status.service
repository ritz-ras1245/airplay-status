[Unit]
Description=AirPlay Status dashboard (Node)
Documentation=https://github.com/ritz-ras1245/airplay-status
After=network-online.target shairport-sync.service
Wants=shairport-sync.service

[Service]
Type=simple
User=airplay-status
Group=airplay-status
WorkingDirectory=/opt/airplay-status
EnvironmentFile=-/opt/airplay-status/.env
Environment=SKIP_SHAIRPORT_CHECK=1
ExecStart=/usr/bin/node src/index.js
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
