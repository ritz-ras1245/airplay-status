# Tidbyt credentials — keep on iPhone (Files/iCloud) or Mac; never commit filled copy.
# Upload once to Pi via web setup or apply-secrets-file.sh
# Push enables automatically when ID + token are set (no TIDBYT_ENABLED).

TIDBYT_DEVICE_ID=
TIDBYT_API_TOKEN=
TIDBYT_INSTALLATION_ID=airplaystatus

# Optional — force off without removing creds:
# DISABLE_TIDBYT=1
