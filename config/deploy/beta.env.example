# P49 beta on Raspberry Pi — copy to .env on the Pi (not committed)
# After copy: ./bin/render-shairport-config.sh --stage beta

DEPLOY_STAGE=beta
DEPLOY_PHASE=p49
DEPLOY_HOST=rpi4-beta

PORT=3003
LOG_LEVEL=info

# iPhone AirPlay picker name (must match rendered shairport-sync config)
AIRPLAY_RECEIVER_NAME="AirPlay Status (Beta)"
SHAIRPORT_LOG_VERBOSITY=1

# Tidbyt — see docs/p49-tidbyt-credentials.md (use tidbyt.env + setup URL or apply-secrets-file.sh)
# Auto-enables when TIDBYT_DEVICE_ID + TIDBYT_API_TOKEN are set.
# TIDBYT_DEVICE_ID=
# TIDBYT_API_TOKEN=
# TIDBYT_INSTALLATION_ID=airplaystatus
# DISABLE_TIDBYT=1
