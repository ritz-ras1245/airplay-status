// AirPlay Status — shairport-sync configuration (macOS / classic AirPlay 1)
// Copy to: ~/.config/shairport-sync/shairport-sync.conf
//
// NOTE: Homebrew shairport-sync is AirPlay 1 only. iPhone cannot select this
// receiver together with HomePlay / AP2 speakers in one group.
// See docs/multi-room-airplay.md and config/shairport-sync-airplay2.conf.example (Pi/Linux).
// Verify backends: shairport-sync -h

general =
{
  name = "AirPlay Status";
  output_backend = "pipe";
  mdns_backend = "dns-sd";   // macOS Bonjour (use "avahi" on Linux)
  interpolation = "basic";
  ignore_volume_control = "yes";
};

// Discard audio — metadata only
pipe =
{
  name = "/dev/null";
};

metadata =
{
  enabled = "yes";
  include_cover_art = "yes";
  pipe_name = "/tmp/shairport-sync-metadata";
  pipe_timeout = 5000;
};

diagnostics =
{
  log_verbosity = 1;
};
