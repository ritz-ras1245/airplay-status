# Local overrides — copy from config/deploy/*.env.example (gitignored)
# Mac dev stage: DEPLOY_STAGE=dev in .env
# Mac Tidbyt creds: .local/tidbyt.env (see config/deploy/tidbyt.env.example) — not wiped by beta .env refresh
# Pi beta: cp config/deploy/beta.env.example .env

# Stage: dev | beta | prod
# DEPLOY_STAGE=dev
# DEPLOY_PHASE=p49
# DEPLOY_HOST=mac-studio
# PORT=3003
# LOG_LEVEL=info
# AIRPLAY_RECEIVER_NAME=AirPlay Status
# SHAIRPORT_LOG_VERBOSITY=1

# Tidbyt — prefer .local/tidbyt.env on Mac (Settings → Get API Key)
# TIDBYT_DEVICE_ID=
# TIDBYT_API_TOKEN=
# TIDBYT_INSTALLATION_ID=airplaystatus

# Echo Show (P6) — webhook push on track change (Tier B)
# ECHO_PUSH_ENABLED=0
# ECHO_PUSH_WEBHOOK_URL=
# ECHO_PUSH_SECRET=
# ECHO_DISPLAY_URL=http://airplay-status.home.arpa:3003/echo
