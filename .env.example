# Local overrides — copy from config/deploy/*.env.example (gitignored)
# P49 beta on Pi: cp config/deploy/beta.env.example .env

# Stage: dev | beta | prod  (beta → "AirPlay Status (Beta)" on iPhone)
# DEPLOY_STAGE=dev
# DEPLOY_PHASE=p49
# DEPLOY_HOST=rpi4-beta
# PORT=3003
# LOG_LEVEL=info
# AIRPLAY_RECEIVER_NAME=AirPlay Status (Beta)
# SHAIRPORT_LOG_VERBOSITY=1

# Tidbyt (Settings → Get API Key)
TIDBYT_DEVICE_ID=
TIDBYT_API_TOKEN=
TIDBYT_INSTALLATION_ID=airplaystatus
