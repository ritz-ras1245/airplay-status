# Tidbyt integration (local only — .env is gitignored)
# Copy to .env and fill in credentials from Tidbyt app: Settings → Get API Key
#
# Push starts automatically when DEVICE_ID + API_TOKEN are set and pixlet is installed.
# Set TIDBYT_ENABLED=0 to disable even with credentials present.

TIDBYT_DEVICE_ID=
TIDBYT_API_TOKEN=
TIDBYT_INSTALLATION_ID=airplaystatus
